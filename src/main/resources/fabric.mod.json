{
	"schemaVersion": 1,
	"id": "gahtmod",
	"version": "${version}",
	"name": "GAHT Mod",
	"description": "A mod that adds gender affirming hormone therapy to Minecraft.",
	"authors": [
		"Lumelore"
	],
	"contact": {
		"homepage": "https://lumelore.net/mods/mc-gaht-mod/",
		"sources": "https://github.com/Lumelore/gahtmod"
	},
	"license": ["Code: GPL-3.0 license", "Graphical & Audio Assets: CC-BY-SA 4.0"],
	"icon": "assets/gahtmod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.lumelore.gahtmod.GAHTMod"
		],
		"client": [
			"net.lumelore.gahtmodclient.GAHTModClient"
		]
	},
	"mixins": [
		"gahtmod.mixins.json",
		{
			"config": "gahtmod.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
        "fabricloader": ">=0.20.1",
        "minecraft": "~26.3",
        "java": ">=25",
        "fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}

}